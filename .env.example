# Server-side Gemini Developer API settings. Never expose this key to the browser.
GEMINI_API_KEY=
# Stable free-tier default used when omitted.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional timeout for each Gemini HTTP attempt in milliseconds.
GEMINI_TIMEOUT_MS=30000
# Shared provider gate and per-case reliability budgets.
GEMINI_MIN_INTERVAL_MS=4200
GEMINI_MAX_CONCURRENCY=1
GEMINI_MAX_REQUESTS_PER_CASE=20
GEMINI_MAX_TOKENS_PER_CASE=30000
GEMINI_RETRIES=3
GEMINI_RETRY_BASE_MS=1000
GEMINI_MAX_RETRY_DELAY_MS=60000
# Overall wall-clock budget for one case (12 minutes).
PIPELINE_DEADLINE_MS=720000
# Optional trusted test/proxy override. Production should use the default Google endpoint.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# API and deployment settings. Keep all values except NEXT_PUBLIC_* server-side.
MONGODB_URI=
MONGODB_DB=jobber
# Generate with: openssl rand -base64 32
SESSION_SECRET=
# Persisted session and password/login-hardening defaults.
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
LOGIN_WINDOW_MINUTES=15
LOGIN_EMAIL_LIMIT=5
LOGIN_IP_LIMIT=20
# Mongo-backed generation worker settings. The API process polls and atomically leases jobs.
JOB_LEASE_SECONDS=60
JOB_POLL_MS=1000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=5000
# Increment when generation semantics change enough that active-input deduplication should not cross versions.
PIPELINE_VERSION=1
# Comma-separated exact web origins; never use * with credentialed requests.
WEB_ORIGINS=http://localhost:3000
PORT=4000
APP_RELEASE=development
MONGODB_CONNECT_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
